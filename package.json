    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.9.14",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^27.0.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
