    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.25.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "mini-svg-data-uri": "^1.4.4",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
