# PostgreSQL connection string used by Prisma (see prisma.config.ts)
DATABASE_URL=

# Secret used by next-auth to sign/encrypt session tokens (openssl rand -base64 32)
NEXTAUTH_SECRET=

# Canonical app URL; read internally by next-auth (required when deployed beyond localhost)
NEXTAUTH_URL=

# Google OAuth 2.0 client credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 client secret paired with GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=

# OpenRouter API key powering meal plans, food analysis, swaps, nuskhe and dinacharya routes
OPENROUTER_API_KEY=

# Public base URL sent to OpenRouter as HTTP-Referer for app attribution
NEXT_PUBLIC_SITE_URL=
